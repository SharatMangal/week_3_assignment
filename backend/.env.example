# Copy to .env and fill in your values. Never commit .env.

# --- Required ---
# OpenRouter (embeddings for queries, query refinement, answer generation): https://openrouter.ai/keys
OPENROUTER_API_KEY=''
# Qdrant Cloud cluster URL and API key: https://cloud.qdrant.io
QDRANT_URL=''
QDRANT_API_KEY=''

# --- Optional ---
# Must match the model used to create the uploaded vectors (BAAI/bge-large-en-v1.5, 1024 dims)
EMBEDDING_MODEL=baai/bge-large-en-v1.5

# Reranking: "cohere" enables the Cohere reranker (needs COHERE_API_KEY); any other value
# (e.g. "none") disables it. If the Cohere call fails, retrieval falls back to hybrid ranking.
RERANKER_TYPE=none
USE_RERANKER=true
COHERE_API_KEY=''

# Path to chunks.json (defaults to ./chunks.json)
CHUNKS_PATH=./chunks.json

# Port for the API server (Render sets this automatically; defaults to 8082 locally)
# PORT=8082
